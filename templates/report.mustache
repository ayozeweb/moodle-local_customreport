{{!
    @template local_customreport/report

    Follow-up report of a training action.

    Context variables required for this template:
    * actionname - Action name
    * generated - Generation date
    * logos - Array of logos (url, alt)
    * summary - Array of rows (label, value)
    * nodes - Array of rows (code, name, hours, passed, passedpercent, time, avgtime)
    * areas - Array of rows (name, accesses, accessespercent, time, participations)
    * learners - Array of rows (fullname, status, accesses, participations, time, done, percent, process, final, score, call)
    * charts - Array of charts (title, html)

    Example context (json):
    {
        "actionname": "Action", "generated": "04/11/2026",
        "logos": [{"url": "https://example.com/logo.png", "alt": "Logo"}],
        "summary": [{"label": "Learners", "value": "10"}],
        "nodes": [{"code": "MF1", "name": "Module", "hours": 60, "passed": 5, "passedpercent": "50", "time": "10:00", "avgtime": "01:00"}],
        "areas": [{"name": "Forum", "accesses": 4, "accessespercent": "40", "time": "01:00", "participations": 2}],
        "learners": [{"fullname": "Ana", "status": "Started", "accesses": 3, "participations": 1, "time": "01:00", "done": "1/2",
            "percent": "50", "process": "7", "final": "5", "score": "6.2", "call": "1"}],
        "charts": [{"title": "Chart", "html": "<div></div>"}]
    }
}}
<div class="local-customreport-report">
    {{#logos}}<img src="{{url}}" alt="{{alt}}" class="local-customreport-logo" style="max-height: 60px; margin-right: 1rem;">{{/logos}}
    <h2>{{actionname}}</h2>
    <p>{{#str}} generatedon, local_customreport, {{generated}} {{/str}}</p>

    <h3>{{#str}} summary, local_customreport {{/str}}</h3>
    <table class="generaltable">
        <caption class="sr-only">{{#str}} summary, local_customreport {{/str}}</caption>
        <tbody>
            {{#summary}}<tr><th scope="row">{{label}}</th><td>{{value}}</td></tr>{{/summary}}
        </tbody>
    </table>

    {{#charts}}
    <div class="local-customreport-chart mb-4" style="max-width: 720px;">
        <h3>{{title}}</h3>
        {{{html}}}
    </div>
    {{/charts}}

    {{#nodes.0}}
    <h3>{{#str}} structure, local_customreport {{/str}}</h3>
    <table class="generaltable">
        <caption class="sr-only">{{#str}} structure, local_customreport {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} code, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} name {{/str}}</th>
                <th scope="col">{{#str}} hours, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} passed, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} passedpercent, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} totaltime, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} avgtime, local_customreport {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#nodes}}<tr><td>{{code}}</td><td>{{name}}</td><td>{{hours}}</td><td>{{passed}}</td><td>{{passedpercent}} %</td><td>{{time}}</td><td>{{avgtime}}</td></tr>{{/nodes}}
        </tbody>
    </table>
    {{/nodes.0}}

    {{#areas.0}}
    <h3>{{#str}} areas, local_customreport {{/str}}</h3>
    <table class="generaltable">
        <caption class="sr-only">{{#str}} areas, local_customreport {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} area, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_accesses, local_customreport {{/str}}</th>
                <th scope="col">%</th>
                <th scope="col">{{#str}} totaltime, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_participations, local_customreport {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#areas}}<tr><td>{{name}}</td><td>{{accesses}}</td><td>{{accessespercent}} %</td><td>{{time}}</td><td>{{participations}}</td></tr>{{/areas}}
        </tbody>
    </table>
    {{/areas.0}}

    <h3>{{#str}} learners, local_customreport {{/str}}</h3>
    <table class="generaltable">
        <caption class="sr-only">{{#str}} learners, local_customreport {{/str}}</caption>
        <thead>
            <tr>
                <th scope="col">{{#str}} col_fullname, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_status, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_accesses, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_participations, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_timespenthours, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_activitiesdone, local_customreport {{/str}}</th>
                <th scope="col">%</th>
                <th scope="col">{{#str}} col_processaverage, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_finalgrade, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_finalscore, local_customreport {{/str}}</th>
                <th scope="col">{{#str}} col_callnumber, local_customreport {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#learners}}
            <tr><th scope="row">{{fullname}}</th><td>{{status}}</td><td>{{accesses}}</td><td>{{participations}}</td><td>{{time}}</td>
                <td>{{done}}</td><td>{{percent}}</td><td>{{process}}</td><td>{{final}}</td><td>{{score}}</td><td>{{call}}</td></tr>
            {{/learners}}
        </tbody>
    </table>
</div>
