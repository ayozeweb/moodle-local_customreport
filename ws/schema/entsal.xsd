																				<xsd:sequence>
																					<xsd:element maxOccurs="1" minOccurs="1" name="TIPO_DOCUMENTO" nillable="false" type="tipo_documento" />
																					<xsd:element maxOccurs="1" minOccurs="1" name="NUM_DOCUMENTO" nillable="false">
