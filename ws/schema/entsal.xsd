															</xsd:element>
															<xsd:element maxOccurs="1" minOccurs="1" name="CODIGO_CENTRO" nillable="false" type="codigo_centro" />
														</xsd:sequence>
													</xsd:complexType>
												</xsd:element>
												<xsd:element maxOccurs="1" minOccurs="1" name="FECHA_INICIO" nillable="false" type="tipo_fecha" />
